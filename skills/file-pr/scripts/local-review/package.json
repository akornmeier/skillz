{
  "name": "@local/file-pr-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded OpenRouter API-key review, calibration and qualification for Claude Code and Pi.",
  "engines": { "node": ">=22.19.0" },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
