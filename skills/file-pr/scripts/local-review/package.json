    "validate": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
